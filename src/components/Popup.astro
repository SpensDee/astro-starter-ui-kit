---
import { getRandomString } from "../functions/random";

const getRandomID = getRandomString();

const { backdrop, close } = Astro.props;
---
<button popovertarget={getRandomID} class="open-popup"> Open Popover </button>

<dialog id={getRandomID} popover=auto>
    <div class="popup-inner">
        <!-- ts-ignore -->
        <button class="close-btn" popovertarget={getRandomID} popovertargetaction="hide">{close ? close : '❌'}</button>
        <slot/>
    </div>
</dialog>


<style lang="scss" define:vars={{backdrop}}>
:root {
    --popup-width: 600px;
    --popup-height: 600px;
    --popup-backdrop: rgba(42, 41, 41, 0.5);
    --popup-padding: 30px;
    --popup-border-radius: 16px;
}

dialog {
    transition: opacity 0.2s, transform 0.2s, display 0.2s allow-discrete;
    max-height: min(var(--popup-width), calc(100dvh - 40px));
    max-width: min(var(--popup-height), calc(100vw - 40px));
    overscroll-behavior: contain;
    opacity: 0;
    transform: scale(0.8);
    padding: var(--popup-padding);
    border: none;
    border-radius: var(--popup-border-radius);
}

body :is(button, a, image):has(dialog:popover-open) {
    overflow: hidden;
    pointer-events: none;
}

dialog:popover-open {
    opacity: 1;
    transform: scale(1);
    overflow: auto;
    pointer-events: auto;
}

@starting-style {
    dialog:popover-open {
      opacity: 0;
      transform: scale(0.8);
    }
}

dialog::backdrop {
    background: var(--popup-backdrop);
}

body:has(dialog:popover-open) {
    overflow: hidden;
    pointer-events: none;
}

.popup-inner .close-btn {
    position: sticky;
    top: 0;
    left: 100%;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
    outline: transparent;
}

.popup-inner .close-btn:hover {
    background-color: greenyellow;
}

