---
const { type } = Astro.props;
---
{type === 'main' && (
    <h1 data-translate="mainTitle">
        <picture>
            <source srcset="/title1-ua-mob.svg" media="(max-width: 720px)" />
            <img src="/title1-ua.svg" width="100%" alt="мапа affiliate - пристрасті" />
        </picture>
    </h1>
)}

{type === 'second' && (
    <h1 data-translate="secondTitle">
        <img src="/title2-ua-mob.svg" width="100%" alt="мапа affiliate - пристрасті"/>
    </h1>
)}

{type === 'additional' && (
    <h1 data-translate="additionalTitle" class="additional-title">
        <picture>
            <source srcset="/title3-ua-mob.svg" media="(max-width: 720px)" />
            <img src="/title3-ua.svg" width="100%" alt="щоденні призи"/>
        </picture>
    </h1>
)}
<style lang="scss">
    @use 'src/styles/vars' as *;

    h1 {
        max-width: 800px;
        pointer-events: none;
        user-select: none;
        z-index: 2;
    }   
    .additional-title {
        max-width: 900px;
    }
</style>
