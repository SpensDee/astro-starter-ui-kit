---
import ButtonHearth from "@components/Buttons/ButtonHearth.astro";
---

<form>
    <img src="/logo-title.svg">
    <legend>
        <label class="form__label form-status">
            <span data-translate="formRadio"></span>
            <div class="form__radio-group">
                <label class="form__radio">
                    <input type="radio" name="partner" value="web" checked>
                    <span class="form__radio-custom"></span> 
                    <span data-translate="formRadio1"></span>
                </label>
                <label class="form__radio">
                    <input type="radio" name="partner" value="visitor">
                    <span class="form__radio-custom"></span> 
                    <span data-translate="formRadio2"></span>
                </label>
            </div>
        </label>
    
        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="tel" name="phone" class="form__input" 
                maxlength="16"
                placeholder="@Введіть ваш номер телефону"
                data-translate="placeholderPhone"
                autocomplete="off"
                >
            </div>
        </label>

        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="text" name="id" class="form__input" 
                placeholder="@Введіть ваш ID партнера"
                data-translate="ppid"
                autocomplete="off"
                >
            </div>
        </label>
        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="text" name="inst" class="form__input" 
                required
                placeholder="@Введіть ваш Instagram"
                data-translate="inst"
                autocomplete="off"
                >
            </div>
        </label>
    </legend>
        <a style="opacity: 0; pointer-events: none;" class="s-link" data-translate="link" href="https://aff.onepartners.io/signup/affiliate?source=valentine_day">Зареєструватися у One Partners</a>
    <div class="b-modal-btn">
        <ButtonHearth text="startGameButton" type="submit" link="/play"/>
    </div>
    <br>
    <div class="desc" data-translate="formDesc">
        <p style="color: #fafafa">*Від вашого вибору у блоці «Зареєстрований у партнерці» залежить тип завдань:</p>
        <p>❤️ Вибір <span style="color: #EDFF00">«Так»</span>— це завдання розраховані для вебмайстрів зі списку оферів з бустом ставок.</p>
        <p>❤️ Вибір <span style="color: #EDFF00">«Ні»</span> — завдання підлягають виконанню у соціальних мережах.</p>
        <p>✅ Участь можлива у двох частинах карти одночасно! </p>
    </div>
</form>

<script>
    // валидация
document.addEventListener("DOMContentLoaded", () => {
    if((localStorage.getItem('status') === 'visitor' && localStorage.getItem('phone') && localStorage.getItem('instagram')) ||
    localStorage.getItem('status') === 'web' && localStorage.getItem('instagram') && localStorage.getItem('partner_id')) {
        window.location.href = '/play'
    }

    const form = document.querySelector("form") as HTMLFormElement;
    const phoneInput = form.querySelector("input[name='phone']") as HTMLInputElement;
    const idInput = form.querySelector("input[name='id']") as HTMLInputElement;
    const tellInput = form.querySelector("input[name='inst']") as HTMLInputElement;
    const radioWeb = form.querySelector("input[value='web']") as HTMLInputElement;
    const radioVisitor = form.querySelector("input[value='visitor']") as HTMLInputElement;
    const submitButton = form.querySelector(".b-modal-btn") as HTMLButtonElement;
    const linkToOne = document.querySelector('.s-link') as HTMLElement;

    function saveToLocalStorage(): void {
        const status = radioWeb.checked ? "web" : "visitor";
        const phone = phoneInput.value.trim();
        const partner_id = idInput.value.trim();
        const instagram = tellInput.value.trim();


        localStorage.setItem("status", status);
        localStorage.setItem("phone", phone);
        localStorage.setItem("partner_id", partner_id);
        localStorage.setItem("instagram", instagram);
    }

    function validateForm(): void {
    const isPhoneFilled = phoneInput.value.trim().length > 0;
    const isIdFilled = idInput.value.trim().length > 0;
    const isInstFilled = tellInput.value.trim().length > 0;
    const isWebSelected = radioWeb.checked;
    const isVisitorSelected = radioVisitor.checked;

    // Делаем только нужные поля обязательными
    phoneInput.required = isVisitorSelected; // Телефон нужен только для visitor
    idInput.required = isWebSelected; // ID нужен только для web
    tellInput.required = true; // Instagram всегда обязателен

    const idLabel = idInput.closest(".form__label") as HTMLElement | null;
    const phoneLabel = phoneInput.closest(".form__label") as HTMLElement | null;

if (isWebSelected) {
    if (idLabel) idLabel.style.display = "block";
    if (phoneLabel) phoneLabel.style.display = "none";
    if(linkToOne) linkToOne.style.opacity = "0";
    if(linkToOne) linkToOne.style.pointerEvents = "none";

    phoneInput.value = ""; // Очищаем поле, чтобы оно не мешало
} 
else if (isVisitorSelected) {
    if (idLabel) idLabel.style.display = "none";
    if (phoneLabel) phoneLabel.style.display = "block";
    if(linkToOne) linkToOne.style.opacity = "1";
    if(linkToOne) linkToOne.style.pointerEvents = "auto";

    idInput.value = ""; // Очищаем поле, чтобы оно не мешало
}


    // Проверка условий для активации кнопки
    if (
        isInstFilled && // Instagram всегда обязателен
        ((isWebSelected && isIdFilled) || (isVisitorSelected && isPhoneFilled)) // Web → ID нужен, Visitor → Phone нужен
    ) {
        submitButton.disabled = false;
        submitButton.style.pointerEvents = "auto";
        submitButton.style.opacity = "1"; 
    } else {
        submitButton.disabled = true;
        submitButton.style.pointerEvents = "none";
        submitButton.style.opacity = "0.5"; 
    }

    saveToLocalStorage();
}


    // запись данніх в локал сторейдж
    function restoreFromLocalStorage(): void {
        const storedStatus = localStorage.getItem("status");
        const storedPhone = localStorage.getItem("phone");
        const storedPartnerId = localStorage.getItem("partner_id");
        const storedInstagram = localStorage.getItem("instagram");

        if (storedPhone) phoneInput.value = storedPhone;
        if (storedPartnerId) idInput.value = storedPartnerId;
        if (storedInstagram) tellInput.value = storedInstagram;
        if (storedStatus === "web") radioWeb.checked = true;
        if (storedStatus === "visitor") radioVisitor.checked = true;

        validateForm();
    }

    // Восстанавливаем данные при загрузке страницы
    restoreFromLocalStorage();

    // Отслеживание изменений в полях и радиокнопках
    phoneInput.addEventListener("input", validateForm);
    idInput.addEventListener("input", validateForm);
    tellInput.addEventListener("input", validateForm);
    radioWeb.addEventListener("change", validateForm);
    radioVisitor.addEventListener("change", validateForm);
});


document.addEventListener('DOMContentLoaded', () => {
    // Получаем элементы формы
    const tellInput = document.querySelector<HTMLInputElement>('input[name="phone"]')?.parentElement?.parentElement;
    const ppidInput = document.querySelector<HTMLInputElement>('input[name="id"]')?.parentElement?.parentElement;
    const webRadio = document.querySelector<HTMLInputElement>('input[name="partner"][value="web"]');
    const visitorRadio = document.querySelector<HTMLInputElement>('input[name="partner"][value="visitor"]');

    // Проверяем, что все элементы найдены
    if (!tellInput || !ppidInput || !webRadio || !visitorRadio) {
        console.error('One or more form elements not found');
        return;
    }

    // Функция переключения полей
    const toggleInputs = (): void => {
        if (webRadio.checked) {
            // Показываем поле ID партнера и скрываем Instagram
            ppidInput.style.display = 'grid';
            tellInput.style.display = 'none';
        } else if (visitorRadio.checked) {
            // Показываем поле Instagram и скрываем ID партнера
            tellInput.style.display = 'grid';
            ppidInput.style.display = 'none';
        }
    };

    // Добавляем обработчики для радиокнопок
    webRadio.addEventListener('change', toggleInputs);
    visitorRadio.addEventListener('change', toggleInputs);

    // Вызываем функцию при загрузке страницы для установки начального состояния
    toggleInputs();
});
</script>

<style lang="scss">
    @use 'src/styles/vars' as *;

    .s-link {
        display: flex;
        width: 100%;
        justify-content: center;
        font-size: 16px;
        color: var(--accent-color);
        text-decoration: underline;
        text-underline-offset: 4px;
        margin-bottom: 10px;

        @include md() {
            font-size: 14px;
        }

        &:hover {
            opacity: .75;
        }
    }

    .desc {
        font-size: 12px;
        color: #cecece; 
        & p {
            margin: 0;
            margin-bottom: 6px;
        }
    }

    article {
        @extend %flex-center;
    }

    .b-modal-btn {
        display: flex;
        justify-content: center;
        font-family: 'MabryPro';
        user-select: none;
    }

    :root {
    --primary-color: #661FFF; /* Основной цвет */
    --text-color: white;
    // --placeholder-color: rgba(255, 255, 255, 0.5);
    --placeholder-color: white;
    --border-color: #ffffffb3;
}

/* Основные стили формы */
form {
    font-family: 'MabryPro';
    font-weight: 400;
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 40px;
    gap: 20px;
    width: 100%;

    & img {
        max-width: 320px;
        
        @include md() {
            max-width: 80%;
        }
    }
}

legend {
    display: flex;
    flex-direction: column;
    row-gap: 20px;

    @include md() {
        width: 100%;
    }
}

/* Метки */
.form__label {
    font-size: 26px;
}

/* Радио-кнопки */
.form__radio-group {
    display: flex;
    align-items: center;
    gap: 20px;
}

.form__radio {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.form__radio input {
    display: none;
}

.form__radio-custom {
    width: 25px;
    height: 25px;
    border: 2px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.form__radio-custom::after {
    content: "";
    background-image: url('data:image/svg+xml,<svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.25 7.64707L12.8333 0L14 1.17647L5.25 10L0 4.70592L1.16667 3.52945L5.25 7.64707Z" fill="white"/></svg>');
    transform: scale(0);
    width: 14px;
    height: 10px;
    color: var(--border-color);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    transition: transform 0.2s;
}

.form__radio input:checked + .form__radio-custom::after {
    transform: scale(1);
}

/* Поле ввода почты */
.form__input-wrapper {
    position: relative;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 5px;
    display: flex;
    align-items: center;

    &::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: -2px;
        height: 2px;
        width: 0;
        background-color: var(--accent-color);
        transition: all .5s ease-in;
    }

    &:focus-within{
        &::after{
            width: 100%;
            left: 0;
        }
        & input::placeholder {
            color: var(--accent-color);
        }
    }

    &:hover input::placeholder {
        color: var(--accent-color);
    }

}

input:-webkit-autofill,
input:-webkit-autofill:hover, 
input:-webkit-autofill:focus, 
input:-webkit-autofill:active{
    -webkit-background-clip: text;
    -webkit-text-fill-color: #ffffff;
    transition: background-color 5000s ease-in-out 0s;
    box-shadow: inset 0 0 20px 20px #23232329;
}

.form__input {
    width: 100%;
    background: none;
    border: none;
    outline: none;
    font-size: 18px;
    color: var(--text-color);
    padding-left: 10px;
    text-align: center;font-size: 18px;
    caret-color: var(--accent-color);

    &::placeholder {
        font-size: 20px;
        color: white;

        @include md() {
            font-size: 16px;
        }
     }
}

/* Скрытие плейсхолдера при вводе */
.form__input:focus + .form__input-placeholder,
.form__input:not(:placeholder-shown) + .form__input-placeholder {
    display: none;
}

.form-phone {
    display: grid;
    grid-template-columns: auto;
    align-items: flex-end;
    column-gap: 10px;
    padding-inline: 20px; 
}

.form-status {
    display: grid;
    grid-template-columns: auto 3fr;
    align-items: flex-end;
    gap: 20px;
    white-space: nowrap;
    font-size: 20px;
    margin-bottom: 10px;

    @include md() {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        font-size: 16px;
    }
}

.form__radio:hover,
.form__radio:hover span {
    border-color: var(--accent-color);
    color: var(--accent-color);
}
</style>