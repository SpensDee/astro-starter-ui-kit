---
import ButtonHearth from "@components/Buttons/ButtonHearth.astro";
---

<form action="/play">
    <img src="/logo-title.svg">
    <legend>
        <label class="form__label form-status">
            <span data-translate="formRadio"></span>
            <div class="form__radio-group">
                <label class="form__radio">
                    <input type="radio" name="partner" value="web" checked>
                    <span class="form__radio-custom"></span> 
                    <span data-translate="formRadio1"></span>
                </label>
                <label class="form__radio">
                    <input type="radio" name="partner" value="visitor">
                    <span class="form__radio-custom"></span> 
                    <span data-translate="formRadio2"></span>
                </label>
            </div>
        </label>
    
        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="tel" name="phone" class="form__input" 
                maxlength="16"
                placeholder="@Введіть ваш номер телефону"
                data-translate="placeholderPhone"
                autocomplete="off"
                >
            </div>
        </label>

        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="text" name="id" class="form__input" 
                placeholder="@Введіть ваш ID партнера"
                data-translate="ppid"
                autocomplete="off"
                >
            </div>
        </label>
        <label class="form__label form-phone">
            <div class="form__input-wrapper">
                <input type="text" name="inst" class="form__input" 
                required
                placeholder="@Введіть ваш Instagram"
                data-translate="inst"
                autocomplete="off"
                >
            </div>
        </label>
    </legend>
        <a style="opacity: 0; pointer-events: none;" class="s-link" data-translate="link" href="https://aff.onepartners.io/signup/affiliate?source=valentine_day">Зареєструватися у One Partners</a>
    <div class="b-modal-btn">
        <ButtonHearth text="startGameButton" type="submit"/>
    </div>
    <br>
    <div class="desc" data-translate="formDesc">
        <p style="color: #fafafa">*Від вашого вибору у блоці «Зареєстрований у партнерці» залежить тип завдань:</p>
        <p>❤️ Вибір <span style="color: #EDFF00">«Так»</span>— це завдання розраховані для вебмайстрів зі списку оферів з бустом ставок.</p>
        <p>❤️ Вибір <span style="color: #EDFF00">«Ні»</span> — завдання підлягають виконанню у соціальних мережах.</p>
        <p>✅ Участь можлива у двох частинах карти одночасно! </p>
    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form") as HTMLFormElement | null;
        if (!form) return;
    
        const phoneInput = form.querySelector("input[name='phone']") as HTMLInputElement;
        const idInput = form.querySelector("input[name='id']") as HTMLInputElement;
        const tellInput = form.querySelector("input[name='inst']") as HTMLInputElement;
        const radioWeb = form.querySelector("input[value='web']") as HTMLInputElement;
        const radioVisitor = form.querySelector("input[value='visitor']") as HTMLInputElement;
        const submitButton = form.querySelector(".b-modal-btn") as HTMLButtonElement;
        const linkToOne = document.querySelector(".s-link") as HTMLElement | null;
    
        function saveToLocalStorage(): void {
            localStorage.setItem("status", radioWeb.checked ? "web" : "visitor");
            localStorage.setItem("phone", phoneInput.value.trim());
            localStorage.setItem("partner_id", idInput.value.trim());
            localStorage.setItem("instagram", tellInput.value.trim());
        }
    
        function validateForm(): void {
            const isWebSelected: boolean = radioWeb.checked;
            const isVisitorSelected: boolean = radioVisitor.checked;
    
            phoneInput.required = isVisitorSelected;
            idInput.required = isWebSelected;
            tellInput.required = true; // Instagram обязателен всегда
    
            const idLabel = idInput.closest(".form__label") as HTMLElement | null;
            const phoneLabel = phoneInput.closest(".form__label") as HTMLElement | null;
    
            if (idLabel) idLabel.style.display = isWebSelected ? "block" : "none";
            if (phoneLabel) phoneLabel.style.display = isVisitorSelected ? "block" : "none";
    
            if (linkToOne) {
                linkToOne.style.opacity = isVisitorSelected ? "1" : "0";
                linkToOne.style.pointerEvents = isVisitorSelected ? "auto" : "none";
            }
    
            if (isWebSelected) phoneInput.value = ""; // Очищаем ненужное поле
            if (isVisitorSelected) idInput.value = "";
    
            submitButton.disabled = !(
                tellInput.value.trim() &&
                ((isWebSelected && idInput.value.trim()) || (isVisitorSelected && phoneInput.value.trim()))
            );
    
            saveToLocalStorage();
        }
    
        function restoreFromLocalStorage(): void {
            phoneInput.value = localStorage.getItem("phone") || "";
            idInput.value = localStorage.getItem("partner_id") || "";
            tellInput.value = localStorage.getItem("instagram") || "";
    
            const storedStatus = localStorage.getItem("status");
            if (storedStatus === "web") radioWeb.checked = true;
            if (storedStatus === "visitor") radioVisitor.checked = true;
    
            validateForm();
        }
    
        restoreFromLocalStorage();
    
        form.addEventListener("input", validateForm);
        radioWeb.addEventListener("input", validateForm);
        radioVisitor.addEventListener("input", validateForm);
    });
    </script>
    

<style lang="scss">
    @use 'src/styles/vars' as *;

    .s-link {
        display: flex;
        width: 100%;
        justify-content: center;
        font-size: 16px;
        color: #EDFF00;
        text-decoration: underline;
        text-underline-offset: 4px;
        margin-bottom: 10px;

        @include md() {
            font-size: 14px;
        }

        &:hover {
            opacity: .75;
        }
    }

    .desc {
        font-size: 12px;
        color: #cecece; 
        & p {
            margin: 0;
            margin-bottom: 6px;
        }
    }

    article {
        @extend %flex-center;
    }

    .b-modal-btn {
        display: flex;
        justify-content: center;
        font-family: 'MabryPro';
        user-select: none;
    }

    :root {
    --primary-color: #661FFF; /* Основной цвет */
    --text-color: white;
    // --placeholder-color: rgba(255, 255, 255, 0.5);
    --placeholder-color: white;
    --border-color: #ffffffb3;
}

/* Основные стили формы */
form {
    font-family: 'MabryPro';
    font-weight: 400;
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 40px;
    gap: 20px;
    width: 100%;

    & img {
        max-width: 320px;
        
        @include md() {
            max-width: 80%;
        }
    }
}

legend {
    display: flex;
    flex-direction: column;
    row-gap: 20px;

    @include md() {
        width: 100%;
    }
}

/* Метки */
.form__label {
    font-size: 26px;
}

/* Радио-кнопки */
.form__radio-group {
    display: flex;
    align-items: center;
    gap: 20px;
}

.form__radio {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.form__radio input {
    display: none;
}

.form__radio-custom {
    width: 25px;
    height: 25px;
    border: 2px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.form__radio-custom::after {
    content: "";
    background-image: url('data:image/svg+xml,<svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.25 7.64707L12.8333 0L14 1.17647L5.25 10L0 4.70592L1.16667 3.52945L5.25 7.64707Z" fill="white"/></svg>');
    transform: scale(0);
    width: 14px;
    height: 10px;
    color: var(--border-color);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    transition: transform 0.2s;
}

.form__radio input:checked + .form__radio-custom::after {
    transform: scale(1);
}

/* Поле ввода почты */
.form__input-wrapper {
    position: relative;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 5px;
    display: flex;
    align-items: center;

    & input {
        height: 40px;
        z-index: 9999999;
        position: relative;
        width: 100%;
    }

    &:hover  {
       border-color: #EDFF00;
    }

}

.form__input {
    width: 100%;
    background: none;
    border: none;
    outline: transparent;
    font-size: 18px;
    color: var(--text-color);
    padding-left: 10px;
    text-align: center;font-size: 18px;
    caret-color: #EDFF00;

    &::placeholder {
        font-size: 20px;
        color: white;

        @include md() {
            font-size: 16px;
        }
     }
}

/* Скрытие плейсхолдера при вводе */
.form__input:focus + .form__input-placeholder,
.form__input:not(:placeholder-shown) + .form__input-placeholder {
    display: none;
}

.form-phone {
    display: grid;
    grid-template-columns: auto;
    align-items: flex-end;
    column-gap: 10px;
    padding-inline: 20px; 
}

.form-status {
    display: grid;
    grid-template-columns: auto 3fr;
    align-items: flex-end;
    gap: 20px;
    white-space: nowrap;
    font-size: 20px;
    margin-bottom: 10px;

    @include md() {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        font-size: 16px;
    }
}

.form__radio:hover,
.form__radio:hover span {
    border-color: #EDFF00;
    color: #EDFF00;
}
</style>