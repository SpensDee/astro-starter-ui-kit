---
const { closeBtn, target } = Astro.props;
---

<dialog id={target} popover="auto">
  <div class="popup-wrapper">
    <div class="popup-wrapper__head">
        <span><img src="/hearth-mini.svg"></span>
        <p data-translate="defaultTitle">Мапа affiliate-пристрасті</p>
        <button class="close-btn" popovertarget={target} popovertargetaction="hide">
            <img src={closeBtn || '/close-popup-icon.svg'} alt="close-popup"/>
        </button>
    </div>
    <div class="popup-wrapper__main">
        <div class="popup-content"><slot/></div>
    </div>
    <div class="popup-wrapper__footer">
        <span><img src="/hearth-mini.svg"></span>
        <p>onepartners.io</p>
        <span><img src="/hearth-mini.svg"></span>
    </div>
  </div>
</dialog>

<style lang="scss">
@use 'src/styles/vars' as *;

:root {
    --popup-size: 600px;
    --popup-backdrop: #00000092;
    --popup-padding: 30px;
    --popup-border-radius: 16px;
}

%size {
    width: 35px;
    height: 35px;
}

dialog {
    transition: opacity 0.2s, transform 0.2s, display 0.2s allow-discrete;
    max-width: min(var(--popup-size), calc(100vw - 40px));
    overscroll-behavior: contain;
    opacity: 0;
    transform: scale(0.8);
    padding: var(--popup-padding);
    border: none;
    border-radius: var(--popup-border-radius);
    background-color: #6D06F2;
    color: white;
    font-size: 26px;
    font-family: 'Mabry Pro';
    font-weight: 400;
    max-height: 90dvh;

    @include md() {
        padding: 20px;
        font-size: 16px;
    }
}

.popup-wrapper {
    width: 100%;
    height: auto;
}

dialog:popover-open {
    opacity: 1;
    transform: scale(1);
    overflow: auto;
}

@starting-style {
    dialog:popover-open {
      opacity: 0;
      transform: scale(0.8);
    }
}

dialog::backdrop {
    background: var(--popup-backdrop);
    backdrop-filter: blur(5px);
}

.popup-wrapper .close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    top: 3.7%;
    left: 89.5%;
    @extend %size;
    border-left: 1px solid white;
    transition: all 0.2s;
    cursor: pointer;
    outline: transparent;

    & img {
        transition: transform 0.2s;
        transform-origin: center;
    }

    @media (hover: hover) {
        &:hover img {
            transform: scale(1.2);
        }
    }
}

.popup-content {
    padding: 20px;
    border-left: 1px solid white;
    border-right: 1px solid white;
}

.popup-wrapper {
    &__footer,
    &__head {
        border: 1px solid white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 300;
        font-family: 'MabryPro';
        font-size: 16px;

        & p {
            margin: 0;
            padding: 0;
            padding-inline: 10px;
            white-space: normal;
            text-align: center;
        }

        span {
            display: flex;
            align-items: center;
            justify-content: center;
            @extend %size;
            border-right: 1px solid white;

            &:last-child {
                border-right: none;
                border-left: 1px solid white;
            }
        }
    }

    &__main {
        border-left: 1px solid white;
        border-right: 1px solid white;
        padding-inline: 11px;
    }
}
</style>
