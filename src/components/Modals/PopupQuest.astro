---
import ButtonHearth from '@components/Buttons/ButtonHearth.astro';
const popUps = {
    complete: 'complete'
}
const { complete } = popUps;
---

<section>
    <article class="popup-quest-content">
    </article>
    <div class="b-qb">
        <ButtonHearth 
        text="go" 
        attrs={{
            "popovertarget": complete,
            "type": "button",
            }} 
        />
    </div>
</section>

<style lang="scss">
    .b-qb {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    section {
        font-family: 'MabryPro', sans-serif;
        font-weight: 600;
        text-align: center;
        @media(max-width: 720px) {
            font-size: 24px;
        }

        & p {
            font-family: 'MabryPro', sans-serif;
            font-weight: 400;
            text-align: left;
        }

        &::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 80%;
            background-color: #6D06F2;
            z-index: -1;
            border-radius: var(--popup-border-radius);
        }
    }
    

</style>

<script>
import { days as originalDays, webs } from 'src/functions/data';

const days = localStorage.getItem('status') === 'web' ? webs : originalDays;

const questContent = document.querySelector('.popup-quest-content') as HTMLElement | null;

let currentIndex = null; // Глобальная переменная для хранения текущего индекса

function createQuest(questIndex, translateLang) {
    if (questContent && questIndex && translateLang) {
        const index = Number(questIndex);
        currentIndex = index; // Сохраняем индекс в глобальную переменную

        if (days[index]) {
            console.log(`Обновление UI: ${translateLang}`);
            questContent.innerHTML = `
                <header data-header style="
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 15px;
                    margin-bottom: 30px;
                ">
                  <div style="
                    border-radius: 50%;
                    padding: ${window.matchMedia('(min-width: 720px)').matches ? '20px;' : '8px'};
                    background: #210446;
                    width: ${window.matchMedia('(min-width: 720px)').matches ? '90px;' : '56px'};
                    height: ${window.matchMedia('(min-width: 720px)').matches ? '90px;' : '56px'};
                    aspect-ratio: 1/1;
                ">
                    <img width="100%" height="100%" src="${days[index].logo}" 
                    style="object-fit: contain;" 
                    alt="Квест" />
                </div>
                 <h2 style="
                 font-weight: 600; 
                 font-size: ${window.matchMedia('(min-width: 720px)').matches ? '26px;' : '24px'};
                 text-align: center;
                 ">${days[index][translateLang]?.taskTitle || 'Нет заголовка'}</h2>
                 <img src="/3heart.svg"/>
                </header>
                <p style="
                font-family: 'MabryPro', sans-serif;
                font-weight: 400;
                text-align: left;
                ${window.matchMedia('(min-width: 768px)').matches ? 'font-size: 22px;' : 'font-size: 16px;'}
                ">${days[index][translateLang]?.task || 'Нет задания'}</p>
                <br/>
                <p style="font-size: 12px; text-align: center; color: #cecece;display: flex; justify-content: center;">
                ${localStorage.getItem('lang') === 'ua' ? '* Після виконання квесту підтвердьте це, натиснувши "ОК" на кладці' : ''}
                ${localStorage.getItem('lang') === 'ru' ? '* После выполнения квеста подтвердите это, нажав "ОК" на вкладке' : ''}
                ${localStorage.getItem('lang') === 'en' ? '* After completing the quest, confirm it by clicking "OK" on the tab' : ''}    
                <p/>
            `;
        } else {
            console.error(`Квест с индексом ${index} не найден в days`);
        }
    } else {
        console.error('Ошибка: либо .popup-quest-content не найден, либо questIndex не установлен');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    setQuest();

    document.querySelector('.b-qb')?.addEventListener('click', () => {
        if (currentIndex !== null && days[currentIndex]?.link) {
            window.open(days[currentIndex].link, '_blank', 'noopener,noreferrer');
        } else {
            console.error('Ошибка: currentIndex не установлен или ссылка отсутствует');
        }
    });
});


function setQuest() {
    setTimeout(() => {
        // Считываем язык и индекс после задержки
        const questIndex = window.localStorage.getItem('day');
        const translateLang = window.localStorage.getItem('lang'); 

        console.log(`Язык из localStorage после задержки: ${translateLang}`);

        createQuest(questIndex, translateLang);
    }, 50); // 50ms — достаточно, чтобы данные в localStorage успели обновиться
}

// Для обновления при изменении хэша и после загрузки страницы
window.addEventListener('DOMContentLoaded', setQuest);
window.addEventListener('hashchange', setQuest);

</script>