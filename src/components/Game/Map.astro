</div>
<style>
    svg {
        overflow: visible;
        
    }
    .watch-quest {
		display: flex;
		align-items: flex-end;
		gap: 10px;
        position: absolute;
        bottom: 0 ;
        left: calc(50% + 30px);
        transform: translateX(-50%);
        z-index: 4;
    }

    .watch-quest .btn-open-quest {
			color: white;
			display: inline-block;
			font-size: 14px;
			border-radius: 86px;
			background: #6F02FA;
			white-space: nowrap;
			line-height: 1;
			padding: 10px 15px;
			border: 2px solid white;
            transition: transform .3s;
            cursor: pointer;
		}
        .point {
            width: 50px;
            transform-origin: center; 
            animation: bounce 1.6s infinite ease-in-out 2s;
            will-change: transform;
    }

    .current-day:hover .btn-open-quest,
    .btn-open-quest:hover {
        border-color: yellow;
        color: yellow;
    }
        @media(max-width: 720px) {
            svg {
                width: 25px;
                height: 32px;
            }

           .watch-quest {
                left: 50%;
            }
        }

</style>`)
}


////////////////////////////
document.querySelector('.btn-open-quest').addEventListener('click', () => {
    console.log('click')
    startTimer('#countdown', 20);
});
</script>