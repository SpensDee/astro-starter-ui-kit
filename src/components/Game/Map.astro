        <path d="M32.7656 23.8871C33.698 23.8871 34.4681 24.1869 35.0759 24.7866C35.692 25.378 36 26.1318 36 27.0481C36 27.9643 35.692 28.7222 35.0759 29.3219C34.4598 29.9217 33.6897 30.2215 32.7656 30.2215H29.6645V32.6328H27.2542V23.8871H32.7656ZM32.4783 28.11C32.7864 28.11 33.0361 28.0142 33.2276 27.8227C33.4274 27.6228 33.5273 27.3646 33.5273 27.0481C33.5273 26.8481 33.4815 26.6691 33.39 26.5108C33.3067 26.3442 33.186 26.2151 33.0278 26.1235C32.8696 26.0319 32.6865 25.9861 32.4783 25.9861H29.6645V28.11H32.4783Z" fill="#EDFF00"/>
        <path d="M34.4949 31.1278H36V32.6328H34.4949V31.1278Z" fill="#EDFF00"/>
        <path d="M33.3791 14.6328H36V23.3786H33.7715L29.8752 18.6309V23.3786H27.2542V14.6328H29.6089L33.3791 19.2181V14.6328Z" fill="white"/>
        <path d="M20.3946 30.5366H26.7458V32.6328H18V23.8871H26.7458V25.9833H20.3946V27.2558H26.7458V29.239H20.3946V30.5366Z" fill="white"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M25.803 22.5272C25.7999 22.5299 25.7969 22.5325 25.7938 22.5352C25.1445 21.8375 24.2844 21.3387 23.315 21.1405C24.0585 20.788 24.5727 20.0303 24.5727 19.1525C24.5727 18.374 24.1683 17.6901 23.5583 17.2994C23.4358 17.2209 23.3517 17.0903 23.3517 16.9447V16.4177C23.3517 16.2622 23.1621 16.1862 23.0548 16.2987V16.2987C22.9759 16.3814 22.8399 16.3658 22.7818 16.2675L22.6684 16.0758C22.5365 15.8526 22.2135 15.8526 22.0816 16.0758L21.9682 16.2675C21.9101 16.3658 21.7741 16.3814 21.6952 16.2987V16.2987C21.5879 16.1862 21.3983 16.2622 21.3983 16.4177V16.9447C21.3983 17.0903 21.3142 17.2209 21.1917 17.2994C20.5817 17.6901 20.1773 18.374 20.1773 19.1525C20.1773 20.0303 20.6915 20.788 21.435 21.1405C20.4656 21.3387 19.6055 21.8375 18.9562 22.5352C18.9531 22.5325 18.9501 22.5299 18.947 22.5272C18.9698 22.5489 18.9929 22.5702 19.0164 22.5912C18.6397 22.2545 18.348 21.8255 18.1751 21.3381C18 20.8445 18 20.2298 18 19.0005C18 17.7711 18 17.1564 18.1751 16.6629C18.4825 15.7962 19.1654 15.1145 20.0334 14.8076C20.5278 14.6328 21.1436 14.6328 22.375 14.6328C23.6064 14.6328 24.2222 14.6328 24.7166 14.8076C25.5846 15.1145 26.2675 15.7962 26.5749 16.6629C26.75 17.1564 26.75 17.7711 26.75 19.0005C26.75 20.2298 26.75 20.8445 26.5749 21.3381C26.4128 21.7952 26.1462 22.2009 25.803 22.5272Z" fill="white"/>
        </g>
        <path d="M22.2787 16.3312C22.2608 16.2985 22.2608 16.2589 22.2787 16.2261V16.2261C22.3203 16.1499 22.4297 16.1499 22.4713 16.2261V16.2261C22.4892 16.2589 22.4892 16.2985 22.4713 16.3312V16.3312C22.4297 16.4075 22.3203 16.4075 22.2787 16.3312V16.3312Z" fill="white"/>
