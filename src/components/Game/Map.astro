---
import Title from '@components/Title.astro';
import Picture from 'astro/components/Picture.astro';

import heart from '@assets/heart.png';
import heartBlock from '@assets/heart-block.png';

const days = [
    {
        day: 1,
        x: 50,
        y: 17,
    },
    {
        day: 2,
        x: 67,
        y: 2,
    },
    {
        day: 3,
        x: 88,
        y: 8,
    },
    {
        day: 4,
        x: 102,
        y: 25,
    },
    {
        day: 5,
        x: 97,
        y: 46,
    },
    {
        day: 6,
        x: 85,
        y: 66,
    },
    {
        day: 7,
        x: 68,
        y: 83,
    },
    {
        day: 8,
        x: 50,
        y: 97,
    },
    {
        day: 9,
        x: 32,
        y: 83,
    },
    {
        day: 10,
        x: 14,
        y: 66,
    },
    {
        day: 11,
        x: 2,
        y: 46,
    },
    {
        day: 12,
        x: -2,
        y: 25,
    },
    {
        day: 13,
        x: 11,
        y: 8,
    },
    {
        day: 14,
        x: 32,
        y: 2,
    },
]
---
<div class="map">
    <img class="map__heart" src="/map-path.svg"/>
    <div class="b-title-box">
        <Title type="second"/>
    </div>
    <ol>
        {days.map((day) => (
            <li 
                class={`heart heart-${day.day || ''}`} 
                style={{ top: `${day.y}%`, left: `${day.x}%` }}
            >
                <span class="opening" style="display: none">
                    <img class="bless" src="/bless.png" alt="bless" />
                    <Picture 
                        src={heart} 
                        alt="quest" 
                        width="158" 
                        height="136" 
                        formats={["avif", "webp", "png"]} 
                        draggable="false"
                    />
                </span>
                <span class="blocked">
                    <Picture 
                        src={heartBlock} 
                        alt="quest" 
                        width="158" 
                        height="136" 
                        formats={["avif", "webp", "png"]} 
                        draggable="false"
                    />
                </span>
            </li>
        ))}        
    </ol>
</div>

<style lang="scss">
    @use 'src/styles/vars' as *;

        body {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
    }

    .b-title-box {
        position: absolute;
        top: 48%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 495px;
        width: 100%;
    }
    .map {
        position: relative;
        margin: 46px 100px;

        & img {
            user-select: none;
        }
    }

    .heart {
        object-fit: contain;
        aspect-ratio: 158 / 136;
    }

    ol {
        counter-reset: item;
        position: absolute;
        inset: 0;
    li {
        position: absolute;
        aspect-ratio: 158 / 136;
        transform: translate(-50%, -50%);
        max-width: 160px;
        overflow: visible;

        &:not(.current-day)::before {
            content: counter(item, decimal-leading-zero);
            counter-increment: item;
            display: inline-block;
            font-size: 14px;
            font-weight: 400;
            position: absolute;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;

            @include md() {
                bottom: 16px;
            }

            @include sm() {
                font-size: 8px;
                bottom: 10px;
            }
        }

        &::after {
            content: '';
            width: 22px;
            height: 20px;
            position: absolute;
            bottom: 1px;
            left: 50%;
            transform: translateX(-50%);
            display: block;
        }

        &.open:not(.current-day) {
            &::after {
                background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="22" height="20" viewBox="0 0 22 20" fill="none"><path d="M21.0242 3.27573C20.9267 3.0699 20.8184 2.8749 20.7101 2.69073C20.267 1.94614 19.6544 1.31669 18.9221 0.853591C18.1898 0.390495 17.3585 0.106847 16.4959 0.0257302C15.5795 -0.0596278 14.6559 0.0680596 13.797 0.398815C12.9382 0.729571 12.1675 1.25444 11.5451 1.9324L10.8409 2.7449L10.1259 1.95406C9.50521 1.27571 8.73696 0.749034 7.88044 0.414689C7.02391 0.0803437 6.10202 -0.0527327 5.1859 0.0257302C4.32525 0.104486 3.49525 0.384834 2.76311 0.844068C2.03097 1.3033 1.41728 1.92851 0.971736 2.66906C0.863402 2.85323 0.755069 3.04823 0.657569 3.25406C0.0749605 4.44888 -0.127313 5.7936 0.0780177 7.10694C0.283348 8.42028 0.886409 9.63909 1.8059 10.5991L10.0609 19.1899C10.162 19.2947 10.2831 19.3781 10.4171 19.4351C10.5512 19.4921 10.6953 19.5214 10.8409 19.5214C10.9865 19.5214 11.1307 19.4921 11.2647 19.4351C11.3987 19.3781 11.5198 19.2947 11.6209 19.1899L19.8651 10.5991C20.7818 9.64209 21.3841 8.42778 21.5913 7.11889C21.7984 5.80998 21.6006 4.46903 21.0242 3.27573ZM14.8709 8.3999L11.6209 11.6499C11.5202 11.7514 11.4004 11.832 11.2684 11.887C11.1363 11.942 10.9947 11.9703 10.8517 11.9703C10.7087 11.9703 10.5671 11.942 10.4351 11.887C10.3031 11.832 10.1833 11.7514 10.0826 11.6499L7.9159 9.48323C7.81489 9.38293 7.73463 9.26372 7.67969 9.13241C7.62475 9.00109 7.59622 8.86024 7.59572 8.71789C7.5947 8.43042 7.70793 8.15431 7.91049 7.95031C8.11304 7.74632 8.38834 7.63114 8.67582 7.63013C8.9633 7.62911 9.23941 7.74234 9.4434 7.9449L10.8517 9.35323L13.3542 6.86156C13.5572 6.65979 13.8318 6.54654 14.118 6.54654C14.4042 6.54654 14.6788 6.65979 14.8817 6.86156C15.0788 7.06549 15.188 7.33854 15.186 7.62211C15.184 7.90568 15.0709 8.17715 14.8709 8.37823V8.3999Z" fill="white"/></svg>');
                @include md() {
                    width: 10px;
                    height: 10px;
                   background-repeat: no-repeat;
                   background-size: contain;
                   bottom: 0;
                }
            }
        }
    }
}

.bless {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
    width: 200% !important;
    aspect-ratio: 1 /1;
    object-fit: contain;
    animation: blink 2s infinite ease-in-out;
    display: none;
    pointer-events: none;
}

.current-day .bless {
    display: block;
}

.current-day {
    
    &:hover .opening {
        animation: pulse 3s ease-out infinite;
        transition: transform 0.3s ease;
    }
}

@keyframes pulse {
  0%, 14%, 22%, 30%, 100% {
    transform: scale(1);
  }
  6%, 26% {
    transform: scale(1.05);
  }
}

@keyframes blink {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

.hearth {
    .blocked {
        display: block;
    }
    .opening {
        display: none;
    }
}

.heart.open {
    .blocked {
        display: none;
    }
    .opening {
        display: block;
    }
}

.heart {
    cursor: pointer;
}

.heart .blocked {
    
    &::before {
        content: '';
        background-image: url('/locker.svg');
        width: 31px;
        height: 40px;
        display: block;
        position: absolute;
        top: 45%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    &:hover::before {
        animation: lock 2.8s ease-out;
    }
}



@keyframes lock {
    0% {
        transform: translate(-50%, -50%);
    }
    10% {
        transform: translate(-50%, -50%) scale(1.2) rotate(10deg);
    }
    20% {
        transform: translate(-50%, -50%) scale(1.2) rotate(-10deg);
    }
    30% {
        transform: translate(-50%, -50%) scale(1.2) rotate(10deg);
    }
    40%,
    100% {
        transform: translate(-50%, -50%);
    }
}

    svg {
        overflow: visible;  
    }

    @keyframes bounce {
        0% {
            transform: translateY(0);
        }
        50% {
            // transform: translateY(-6px);
            transform: translate3d(0, -6px, 0);
        }
        100% {
            transform: translateY(0);
        }
    }


@include xxl() {
    .map {
        margin: 36px 83px;

        & img,
        & .heart {
            width: 100% ;
            height: auto ;
        }
        & ol {
            & li {
                max-width: 130px;
            }
        }
    }
}

@include md() {
    .map {
        margin: 26px 52px;

        & ol {
            & li {
                max-width: 90px;
            }
        }
    }
    .heart .blocked:before {
        width: 12px;
        height: 25px;
        background-size: contain;
        background-repeat: no-repeat;
    }
}

@include sm() {
    .map {
        margin: 26px 52px;

        & ol {
            & li {
                max-width: 70px;
            }
        }
    }
}

@media(max-width: 440px) {
    .map {
        margin: 14px 36px;

        & ol {
            & li {
                max-width: 50px;
            }
        }
    }
}

@media(max-width: 370px) {
    .map {
        margin: 14px 23px;
    }
}
</style>

<script>
import { partners, days } from 'src/functions/data';
import { startTimer } from 'src/functions/timer';

function getLogoSizes() {
    const isLargeScreen = matchMedia('(min-width: 720px)').matches;
    const isMediumScreen = matchMedia('(min-width: 440px)').matches;

    return {
        onepartners: isLargeScreen ? '35px' : isMediumScreen ? '15px' : '10px',
        semproConference: isLargeScreen ? '96px' : isMediumScreen ? '50px' : '33px',
        growePartners: isLargeScreen ? '100px' : isMediumScreen ? '60px' : '40px',
        hollyTraff: isLargeScreen ? '75px' : isMediumScreen ? '46px' : '30px',
        arbitrageUp: isLargeScreen ? '53px' : isMediumScreen ? '20px' : '13px',
        oneMedia: isLargeScreen ? '35px' : isMediumScreen ? '18px' : '12px',
        default: isLargeScreen ? '35px' : isMediumScreen ? '15px' : '10px'
    };
}

let logoSizes = getLogoSizes();
const hearths: NodeListOf<HTMLElement> = document.querySelectorAll('.heart');

const openDay = (day: HTMLElement) => {
    day.classList.add('open');
};

// Обновляем при изменении размера окна
matchMedia('(min-width: 560px)').addEventListener('change', () => {
    logoSizes = getLogoSizes();
});

function setLogoSize(status: string) {
    return logoSizes[status] || logoSizes.default;
}

// Получаем текущий день из localStorage, если нет — берём по `days`
const storedDay = localStorage.getItem('day');
const lastOpenDay = storedDay ? parseInt(storedDay, 10) : Math.max(
    ...Object.keys(days)
        .map(Number)
        .filter(day => days[day].open)
);



// Отображаем открытые дни
hearths.forEach((hearth, index) => {
    const dayNumber = index + 1;

    if (dayNumber <= lastOpenDay) {
        openDay(hearth);

        const logo = document.createElement('img');
        hearth.appendChild(logo);

        const dayData = days[dayNumber] || {};
        const partnerEntry = Object.values(partners).find(partner => partner.src === dayData.logo);
        const partnerId = partnerEntry ? partnerEntry.id : 'default';

        logo.src = dayData.logo || '';
        logo.alt = 'logo';
        logo.classList.add('partner-logo');
        logo.style.cssText = `
            position: absolute;
            top: 44%;
            left: 50%;
            max-height: 50px;
            object-fit: contain;
            z-index: 2;
            transform: translate(-50%, -50%);
            width: ${setLogoSize(partnerId)};
        `;

        const blockedElement = hearth.querySelector('.blocked');
        const openingElement = hearth.querySelector('.opening');

        if (blockedElement instanceof HTMLElement) {
            blockedElement.style.display = 'none';
        }

        if (openingElement instanceof HTMLElement) {
            openingElement.style.display = 'block';
        }
    }
});

// Устанавливаем текущий день
const openingDays: NodeListOf<HTMLElement> = document.querySelectorAll('.open');
const lastOpenElement = openingDays[openingDays.length - 1];

if (lastOpenElement) {
    lastOpenElement.classList.add('current-day');
}

if (lastOpenElement) {
    lastOpenElement.classList.add('current-day');
    lastOpenElement.insertAdjacentHTML('beforeend',`
    <div class="watch-quest">
    <span id="countdown"></span>
    ${matchMedia('(min-width: 720px)').matches ? '<button popovertarget="apply" class="btn-open-quest" data-translate="pointer">Завдання на сьогодні</button>' : ''}
