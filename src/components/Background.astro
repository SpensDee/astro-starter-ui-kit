---
import Picture from 'astro/components/Picture.astro';
const { playPage } = Astro.props;

import { getRandomNumber } from './../functions/random';

import decor1 from '../assets/decor-1.png';
import decor2 from '../assets/decor-2.png';
import decor3 from '../assets/decor-3.png';
import decor4 from '../assets/decor-4.png';
import decor5 from '../assets/decor-5.png';
import decor6 from '../assets/decor-6.png';
import decor7 from '../assets/decor-7.png';
import decor8 from '../assets/decor-8.png';
import decor9 from '../assets/decor-9.png';
import decor10 from '../assets/decor-10.png';
import decor11 from '../assets/decor-11.png';
import decor12 from '../assets/decor-12.png';


const decorList = [
    {
        link: decor1,
        width: 24,
        top: 1,
        left: 3,
    }, 
    {
        link: decor2,
        width: 26,
        top: 31,
        left: -1,
    }, 
    {
        link: decor3,
        width: 27.3,
        top: 56,
        left: 15,
    }, 
    {
        link: decor4,
        width: 18,
        top: 64,
        left: 55,
    }, 
    {
        link: decor5,
        width: 40,
        top: 39,
        left: 66,
    }, 
    {
        link: decor6,
        width: 16,
        top: 6,
        left: 78,
    },
]

const decorListPlayPage = [
    {
        link: decor7,
        width: 40,
        top: 65,
        left: 8,
    }, 
    {
        link: decor8,
        width: 58,
        top: 80,
        left: 7,
    }, 
    {
        link: decor9,
        width: 38,
        top: 64,
        left: 50,
    }, 
    {
        link: decor10,
        width: 34,
        top: 4,
        left: 51,
    }, 
    {
        link: decor11,
        width: 30,
        top: 37,
        left: 60,
    }, 
    {
        link: decor12,
        width: 16,
        top: 6,
        left: 78,
    },
]
---

<body class:list={{'play' : playPage}}>
    <div class="decor-axios">
            {(playPage ? decorListPlayPage : decorList).map(({ width: size, link, top, left }, index) => (
            <Picture 
                src={link} 
                alt="decor" 
                style={{
                    width: `${size}%`, 
                    top: `${top}%`,
                    left: `${left}%`,
                    animationDuration: `${getRandomNumber(3, 5)}s`,
                    animationDelay: `${getRandomNumber(0.1, 0.7)}s`,
                }}
                class={`decor decor-${playPage ? (index + 6) : index}`}
                formats={['avif', 'webp', 'png']}
                decoding="async"
            />
        ))}
    </div>
    <slot/>
</body>

<style lang="scss">
    @use 'src/styles/vars' as *;

    body {
        background-image: url('/BG.progressive.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center top;

        @media(max-width: 600px) {
            background-image: url('/BG-mob.progressive.jpg');
            background-position: top center;
        }

        &.play {
            background-image: url('/BG2.progressive.jpg');

            @media(max-width: 600px) {
                background-image: url('/BG2-mob.progressive.jpg');
                background-position: center top;
            }
        }
    }

    .decor-axios {
        position: absolute;
        width: 1920px;
        aspect-ratio: 192 / 110;
        margin: auto;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        user-select: none;

        @include xxl() {
            width: 1220px;
            top: 64%;
            aspect-ratio: 192 / 160;
        }

        @include md() {
            display: block;
            width: 560px;
            aspect-ratio: initial;
            height: 100%;
            top: 50%;
        }
    }

    body:not(.play) {
        .decor-axios {
            display: contents;
        }
    }

    .decor {
        animation-name: fly;
        animation-iteration-count: infinite;
        animation-timing-function: ease-in-out;
        position: absolute;
        object-fit: cover;
        height: auto;
        pointer-events: none;
        user-select: none;
        z-index: -1;

        @include md() {

            &-0 {
                width: 33% !important; 
                top: 93% !important; 
                left: 32% !important;
            }

            &-1 {
                width: 35% !important;
                top: 32% !important;
                left: 7% !important;
            }

            &-2 {
                width: 39% !important;
                top: 70% !important;
                left: 12% !important;
            }

            &-3 {
                width: 35% !important;
                top: 77% !important;
                left: 60% !important;
            }

            &-4 {
                width: 52% !important;
                top: 24% !important;
                left: 57% !important;
            }

            &-5 {
                width: 33% !important;
                top: 3% !important;
                left: 64% !important;
            }
        }
    }

    @keyframes fly {
        0% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
        100% {
            transform: translateY(0);
        }
    }
</style>

