---
import { Image } from "astro:assets";
import button from '@assets/button.png';
const { text, attrs, link } = Astro.props;
---
{!link ? (<button class="button-start" 
    {...attrs}>
	<Image src={button} alt="button" width="216" height="178"/>
    <span data-translate={text}>Розпочати гру</span>
</button>) : (<a class="button-start" href={link}
    {...attrs}>
	<Image src={button} alt="button" width="216" height="178"/>
    <span data-translate={text}>Розпочати гру</span>
</a>)
}

<style lang="scss">
    @use 'src/styles/vars' as *;
    
	.button-start {
		@extend %flex-center;
		position: relative;
		z-index: 9;

		@media (hover: hover) {
			&:hover {
				img {
					animation-name: none;
					filter: drop-shadow(0px 0px 16px #EDFF00);
				}
				span {
					text-shadow: 0px 0px 4px #eaeeae;
				}
			}
		}

		img {
			display: block;
			object-fit: contain;
			z-index: 1;
			animation: pulse 4s ease-out infinite;
			transition: transform 0.3s ease, filter 0.3s ease;
			max-width: 100%;
		}

		span {
			z-index: 2;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			text-align: center;
			color: white;
			transition: text-shadow 0.4s ease;
			font-size: 24px;

				@include md() {
					font-size: 18px;
			}
  		}
}

@keyframes pulse {
  0%, 14%, 22%, 30%, 100% {
    transform: scale(1);
  }
  6%, 26% {
    transform: scale(1.05);
  }
}
</style>


