---
import Popup from '@components/Modals/Popup.astro';
import Layout from '../layouts/Layout.astro';
import Title from '@components/Title.astro';
import Footer from '@components/Footer.astro';
import Subtitle from '@components/Subtitle.astro';
import Description from '@components/Description.astro';
import Wrapper from '@components/Wrapper.astro';
import ButtonHearth from '@components/Buttons/ButtonHearth.astro';
import LangSwitcher from '@components/LangSwitcher.astro';
import Logo from '@components/Logo.astro';
import PopupContentForm from '@components/Modals/PopupContentForm.astro';
import Background from '@components/Background.astro';

const popUps = {
    startGame: 'startGame'
}

const { startGame } = popUps;
---

<Layout>
    <Background>
    <main>
        <div class="b-header">
            <div class="b-header__logo">
                <Logo link="https://onepartners.io?source=valentine_day"/>
            </div>
            <div class="b-header__langs">
                <LangSwitcher/>
            </div>
        </div>
        <div class="b-welcome">
            <div class="b-welcome__title">
                <Title type="main"/>
            </div>
            <Subtitle/>
            <div class="b-description">
                <Wrapper>
                    <Description/>
                    <div class="b-description__btn">
                        <ButtonHearth 
                        text="startGameButton" 
                        attrs={{
                            "popovertarget": startGame,
                            "type": "button"
                            }} 
                        />
                    </div>
                </Wrapper>
            </div>
        </div>
        <div class="b-preview" data-translate="preview">
            <img src="/preview.png" draggable="false" alt="preview">
        </div>
        <div class="b-preview2 b-preview" data-translate="preview2">
            <img src="/preview2.png" draggable="false" alt="preview">
        </div>
        <div class="b-footer">
            <Footer/>
        </div>
    </main>
    <Popup target={startGame}>
        <PopupContentForm/>
    </Popup>  
    </Background>
</Layout>


<style lang="scss">
    @use 'src/styles/vars' as *;

    [class*=b-] {
        width: 100%;
        z-index: 1;
    }

    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        padding-inline: 20px;
    }

    .b-header {
        @extend %flex-row;
        padding: 50px 47px 20px;

        @include xxl() {
            padding-inline: 20px;
        }

        @include md() {
            padding: 20px;
            padding-bottom: 60px;
            justify-content: space-between;
        }

        &__logo {
            display: flex;
            justify-content: flex-end;
            margin-right: -50px;

            @include md() {
                margin-right: -35px;
                justify-content: flex-start;
            }
        }

        &__langs {
            display: flex;
            justify-content: flex-end;
        }
    }
    .b-description {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 100px;

        &__btn {
            display: flex;
            justify-content: center;
            zoom: 0.5;
            transform: translateY(86%) scale(2);
            margin-inline: auto;

            @include md() {
                max-width: 170px;
                margin-top: -20%;
            }
        }
    }

    .b-welcome {
        @extend %flex-center;
        align-items: center;

        &__title {
            max-width: 800px;
            aspect-ratio: 80 / 29; 

            @include md() {
                aspect-ratio: 60 / 26; 
            }
        }
    }

    .b-footer {
        display: flex;
        justify-content: center;
        margin-top: auto;
        padding-block: 30px;
    }

    .b-preview {
        max-width: 980px;
        margin-top: 40vh;
        height: auto;
        pointer-events: none;
        user-select: none;
        width: initial;
        margin-inline: auto;

        & img {
            object-fit: contain;
        }
    }

    .b-preview2 {
        margin-top: 20vh;
        max-width: 1080px;
        margin-bottom: 2vh;
    }
</style>


<script>
    localStorage.setItem('day', '4');
    
    if(localStorage.getItem('select_history') === null) {
        localStorage.setItem('select_history', '2')
    }
    if(localStorage.getItem('select_partner_quest') === null) {
        localStorage.setItem('select_partner_quest', '2')
    }
</script>